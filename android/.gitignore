# Local machine config generated by Gradle/Android Studio - never
# portable across machines and must not be committed.
local.properties

# Build output.
.gradle/
build/
*/build/
.cxx/

# IDE metadata.
.idea/
*.iml

# Signing keystore and any other key material. This must NEVER be
# committed - it is decoded fresh from the ANDROID_KEYSTORE_BASE64
# secret in build-apk.yml and this workflow, and is deleted again
# before this workflow makes its commit.
*.keystore
*.jks
android.keystore

# Misc caches.
.cache/
captures/
.externalNativeBuild/
