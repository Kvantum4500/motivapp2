<!-- The "package" attribute is rewritten by the Gradle build with the value of applicationId.
     It is still required here, as it is used to derive paths, for instance when referring
     to an Activity by ".MyActivity" instead of the full name. If more Activities are added to the
     application, the package attribute will need to reflect the correct path in order to use
     the abbreviated format. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kvantum.motivapp2">

    <!-- MainWebViewActivity hosts a plain WebView loading a remote https URL, unlike the
         Custom-Tabs-based LauncherActivity below, so it needs its own network access. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Backs navigator.geolocation in the WebView (Térkép hike-tracking view, see
         MainWebViewActivity's onGeolocationPermissionsShowPrompt) and the native
         background GPS tracking foreground service below (TrackingBridge/
         TrackingForegroundService). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- For TrackingForegroundService (hike tracking continues locked/backgrounded). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ runtime notification permission (requested in
         MainWebViewActivity.onCreate) - needed for TrackingForegroundService's ongoing
         notification, and for a future native-reminders feature. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect (window.AndroidHealth) read permissions - see
         HealthConnectBridge/HealthDataFetcher/HealthSyncWorker. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>




    <application
        android:name="Application"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:usesCleartextTraffic="false"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/assetStatements" />

        
            <meta-data
                android:name="web_manifest_url"
                android:value="@string/webManifestUrl" />
        

        <meta-data
            android:name="twa_generator"
            android:value="@string/generatorApp" />

        <!-- Maps SDK for Android - backs JourneyMapActivity below. See mapsApiKey
             resolution in app/build.gradle: empty by default (compiles and installs
             fine, the map screen just can't render tiles) until a real
             MAPS_API_KEY is configured (local.properties locally, a MAPS_API_KEY
             GitHub Actions secret in CI). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/mapsApiKey" />

        

        

        
            <activity android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
                android:exported="false"
                android:enabled="true"
                android:excludeFromRecents="true">
                <meta-data
                    android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                    android:value="@string/launchUrl" />
                <intent-filter>
                    <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                    <category android:name="android.intent.category.DEFAULT" />
                </intent-filter>
            </activity>
        

        <!-- App's launcher entry point: a plain WebView loading the live PWA directly,
             with NativeBridge exposed as window.NativeBridge for notification-derived
             data (see MainWebViewActivity.kt / NativeBridge.kt / NotificationForwarderService.kt).
             LauncherActivity below is kept for its https deep-link intent-filter but is
             no longer the launcher. -->
        <activity android:name=".MainWebViewActivity"
            android:label="@string/launcherName"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect opens this to show the app's "why do we request this
                 data" rationale screen. There is no dedicated rationale UI (same as the
                 reference project this was ported from) - it just opens MainWebViewActivity. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Native journey map screen (window.AndroidTracking.openJourneyMap), showing a
             recorded hike's route over real Google Maps tiles - see MapsBridge.kt /
             JourneyMapActivity.kt / MapsUsageStore.kt. Not exported: only ever launched
             from within the app itself (MainWebViewActivity's own bridge call), never a
             valid external entry point. -->
        <activity android:name=".JourneyMapActivity"
            android:label="@string/appName"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <!-- Health Connect's "Manage data" screen opens the app's permission rationale
             through this alias. -->
        <activity-alias
            android:name=".HealthPermissionsRationaleAlias"
            android:exported="true"
            android:targetActivity=".MainWebViewActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- No longer the launcher (see MainWebViewActivity above) - kept exported for its
             https autoVerify deep-link intent-filter below, which still opens links to the
             site in the TWA/Custom-Tabs experience. -->
        <activity android:name="LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:label="@string/launcherName"
            android:exported="true">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launchUrl" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />

            

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/colorPrimaryDark" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/navigationColor" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/navigationColorDark" />

            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/navigationDividerColor" />

            <meta-data
                android:name="androix.browser.trusted.NAVIGATION_BAR_DIVIDER_COLOR_DARK"
                android:resource="@color/navigationDividerColorDark" />

            <meta-data android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash"/>

            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/backgroundColor"/>

            <meta-data android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="@integer/splashScreenFadeOutDuration"/>

            <meta-data android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="@string/providerAuthority"/>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="@string/fallbackType" />

            

            

            <meta-data android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="@string/orientation"/>

            

            

            

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- pathPrefix: kvantum4500.github.io also hosts a second, unrelated app
                     at a different path (see MainWebViewActivity's shouldOverrideUrlLoading
                     for the same host-vs-host+path distinction). Without this, an App Link
                     to that other app's path would open here, in this app's TWA/Custom Tab,
                     under this app's branding - not a bridge-exposure risk (Custom Tabs use
                     real Chrome, no addJavascriptInterface), but still the wrong app opening
                     the wrong content. -->
                <data android:scheme="https"
                    android:host="@string/hostName"
                    android:pathPrefix="/motivapp2/"
                />
            </intent-filter>

            

            
        </activity>

        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <activity android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:configChanges="orientation|screenSize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/providerAuthority"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <service
            android:name=".DelegationService"
            android:enabled="@bool/enableNotification"
            android:exported="@bool/enableNotification">



            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>

        <!-- Notification-listener service for a hardcoded, non-configurable set of
             bank/food notification sources - see NotificationForwarderService.kt for the
             exact package allow-list. There is intentionally no in-app UI to change it.

             Notification access is a system-level special app access the user has to
             grant manually, per app, via Settings > Apps > Special app access >
             Notification access (i.e. an Intent with action
             Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS). This declaration alone does
             not request or enable that access - it just makes the service available for
             the system to bind once granted. Whoever builds the in-app onboarding flow
             for it should deep-link to that settings screen. -->
        <service
            android:name=".NotificationForwarderService"
            android:label="@string/appName"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Native background GPS tracking (window.AndroidTracking) - keeps recording
             the active hike when the screen is locked or the app is backgrounded, which
             a pure WebView/JS watchPosition cannot do on its own. See
             TrackingBridge/TrackingForegroundService/TrackPointStore. -->
        <service
            android:name=".TrackingForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
